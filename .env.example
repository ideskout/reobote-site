# Project Settings > API no painel do Supabase
NEXT_PUBLIC_SUPABASE_URL=https://SEU_PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon

# Apenas dígitos, com DDI e DDD. O site usa este número quando a variável está vazia.
NEXT_PUBLIC_WHATSAPP_PHONE=5519990101192

# Opcional. Usado em sitemap, Open Graph e links absolutos.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcional. Sem a chave, o detalhe mostra um link para o Google Maps.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=
